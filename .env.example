# Server Port
PORT=5000

# Database Connection String (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication Config
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# SMTP Email Notification Provider Config (Ethereal / Resend / SendGrid / Gmail / Brevo)
# If left empty, notifications log to console in dev fallback mode without throwing errors.
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@deliverytracker.com"
