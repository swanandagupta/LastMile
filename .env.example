# Server Port (Local Dev)
PORT=5000

# Supabase PostgreSQL Connection Strings
# Transaction Connection Pooler (Vercel Serverless runtime - Port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection String (Prisma DB Push / Migrations - Port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Authentication Config
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Set to your deployed Vercel frontend URL in production)
CORS_ORIGIN="http://localhost:5173"

# SMTP Email Notification Provider Config (Ethereal / Resend / SendGrid / Gmail / Brevo)
# If left empty, notifications log to console in dev fallback mode without throwing errors.
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@deliverytracker.com"

# Frontend Vercel Environment Variable (Vercel Frontend Project Settings)
VITE_API_BASE_URL="http://localhost:5000/api/v1"
